# ---------------------------------------------------------------------------
# StockMind 环境变量示例
# 复制为 .env 后填入自己的值：  cp .env.example .env
# 说明：AI 配置也可以在应用「设置」页里填写（无需 .env）。
#      若设置了下面的环境变量，则拥有最高优先级，会覆盖设置页里的 provider 配置。
#      适合统一走一个 OpenAI 兼容中转的场景。
# ---------------------------------------------------------------------------

# 【必填】OpenAI 兼容接口的 API Key（DeepSeek / Qwen / 文心 / 豆包 / 智谱 等中转均可）
AI_API_KEY=

# 【可选】自定义接口地址（OpenAI 兼容）。留空则用默认值。
# 例：https://api.deepseek.com/v1
AI_BASE_URL=

# 【可选】主模型名（用于深度分析 / 决策）。留空则用默认值。
# 例：deepseek-chat
AI_MODEL=

# 【可选】快速模型名（用于轻量任务，降低延迟/成本）。留空则回退到 AI_MODEL。
# 例：deepseek-chat
AI_FAST_MODEL=
